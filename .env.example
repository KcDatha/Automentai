# Copy this file to .env.local and fill in the values. Never commit real keys.

# Where the contact form posts its JSON (name, email, company, message).
# Works with form services such as Formspree (https://formspree.io/f/your-form-id)
# or Web3Forms (https://api.web3forms.com/submit).
# Leave empty to hide the form and show the email address instead.
VITE_FORM_ENDPOINT=

# Only needed by services that require a public access key in the request, such as Web3Forms.
VITE_FORM_ACCESS_KEY=
